{{ if eq .chezmoi.hostname "stride-air" -}}
eval "$(~/.local/bin/mise activate zsh)"
{{- else -}}
# mise is installed via Homebrew (/opt/homebrew/bin/mise)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
{{- end }}

# Source machine-local secrets (not tracked by chezmoi or git)
if [ -f "$HOME/.secrets" ]; then
    source "$HOME/.secrets"
fi

# Enable persistent history
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS

# Configure the push directory stack (most people don't need this)
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT

setopt autocd

# Initialize completion
autoload -U compinit; compinit

alias rr='source ~/.zshrc'

# bat — cat replacement
alias cat='bat'

# eza aliases with your preferred defaults
alias ls='eza --icons --git'
alias ll='eza --icons --git --long --header --group'
alias la='eza --icons --git --long --header --group --all'
alias lt='eza --icons --git --tree --level=2'
#export EZA_COLORS="da=36:gm=33"
export EZA_ICONS_AUTO=1

# ripgrep — config file sets defaults, RIPGREP_CONFIG_PATH points to it
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"
alias grep='rg'
alias rgi='rg --ignore-case'
alias rgf='rg --files | rg'

# Helper: pretty disk free
alias freegb='df -k / | awk '\''NR==2 {printf "%.2f GB\n", $4*1024/1000000000}'\'''


# Set up fzf key bindings and fuzzy completion
source <(fzf --zsh)

# Set up zoxide to move between folders efficiently
eval "$(zoxide init zsh)"

# Set up the Starship prompt
eval "$(starship init zsh)"

export EDITOR="nvim"
export VISUAL="subl -w"

export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
autoload -Uz compinit
compinit

# Ensure ~/.local/bin is on PATH
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# Add ~/dotfiles/bin to PATH if it exists
if [ -d "$HOME/dotfiles/bin" ]; then
  case ":$PATH:" in
    *":$HOME/dotfiles/bin:"*) ;;
    *) PATH="$HOME/dotfiles/bin:$PATH" ;;
  esac
fi

{{ if eq .chezmoi.hostname "mind-glider" -}}
# JDK 17 — Expo / Maestro / Android (Azul Zulu via Homebrew)
if /usr/libexec/java_home -v 17 &>/dev/null; then
  export JAVA_HOME="$(/usr/libexec/java_home -v 17)"
  export PATH="$JAVA_HOME/bin:$PATH"
fi

# Android SDK (Android Studio)
export ANDROID_HOME="$HOME/Library/Android/sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"

{{ end -}}
# Setup direnv
eval "$(direnv hook zsh)"

alias dbtf="$HOME/.local/bin/dbt"


# Git helper methods
git-catchup() {
    git fetch origin staging:staging
    git rebase staging
}

git-catchup-push() {
    git fetch origin staging:staging
    git rebase staging
    git push --force-with-lease
}

alias gc='git-catchup'
alias gcp='git-catchup-push'
alias gss='git switch staging'
alias gsm='git switch main'
alias gp='git pull'
alias glola="git log --graph --pretty='%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset' --all"
alias gsb='git-squash-branch'


export PATH="$HOME/.bun/bin:$PATH"

awt() {
    local base_dir="$HOME/.workingtrees"
    mkdir -p "$base_dir"

    # 1. Generate ID and Path
    local uuid=$(python3 -c 'import uuid; print(uuid.uuid4())')
    local target_path="$base_dir/$uuid"

    echo "--- Creating Agent Sandbox ---"

    # 2. Add the worktree
    if git worktree add "$target_path" HEAD; then
        echo "Successfully created: $uuid"

        # 3. Jump into it
        # This triggers mise/zsh hooks naturally
        cd "$target_path"

        echo "Ready for Claude. Run 'claude' or 'mise run test' etc."
        echo "To cleanup later: git worktree remove --force ."
    else
        echo "Error: Failed to create git worktree."
        return 1
    fi
}


# granted.dev — assume must be sourced so env vars reach the parent shell
alias assume="source assume"

# 1Password CLI — sign in (session lasts 30 min of inactivity)
# Usage: opin           -> sign in to default account
#        opin ACCOUNT   -> sign in to a specific account
opin() {
  if [ -n "$1" ]; then
    eval "$(op signin --account "$1")"
  else
    eval "$(op signin)"
  fi
}

{{ if eq .chezmoi.hostname "mind-glider" -}}
alias leetcode='cursor --classic "$HOME/Documents/GitHub/leetcode"'
alias cur='cursor --classic'

{{ end -}}

# ZSH plugins (must be sourced near the end)
[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && \
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# zsh-syntax-highlighting must be sourced last
[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && \
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh


# OpenClaw Completion
[ -f "$HOME/.openclaw/completions/openclaw.zsh" ] && source "$HOME/.openclaw/completions/openclaw.zsh"
export PATH=$PATH:$HOME/.maestro/bin
{{- if eq .chezmoi.hostname "mind-glider" }}

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
# <<< grok installer <<<
{{- end }}


# Added by Antigravity CLI installer
export PATH="$HOME/.local/bin:$PATH"

# chezmoi private source helper
[ -f "$HOME/.config/chezmoi-private/alias.zsh" ] && source "$HOME/.config/chezmoi-private/alias.zsh"

# Private shell config from dotfiles-private (applied with chezmoi-private)
[ -f "$HOME/.config/zsh/private.zsh" ] && source "$HOME/.config/zsh/private.zsh"
