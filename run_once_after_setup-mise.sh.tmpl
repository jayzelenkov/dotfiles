{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

if command -v mise &>/dev/null; then
    echo "→ Installing mise tools (node, python, bun)..."
    mise install
    echo "✓ mise tools installed"
fi
{{ end -}}
