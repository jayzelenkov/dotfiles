{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# mise comes from Homebrew (brew "mise" in Brewfile.shared)
MISE=/opt/homebrew/bin/mise
if [[ ! -x "$MISE" ]]; then
    echo "→ Installing mise..."
    /opt/homebrew/bin/brew install mise
    echo "✓ mise installed"
else
    echo "✓ mise already installed"
fi

# mise global runtimes (versions are pinned in ~/.config/mise/config.toml)
echo "→ Installing global mise tools (node, python, bun)..."
"$MISE" install
echo "✓ mise tools installed"
echo ""

# Clone dotfiles to ~/Documents/GitHub/dotfiles so chezmoi uses it as the source
mkdir -p "$HOME/Documents/GitHub"
if [[ ! -d "$HOME/Documents/GitHub/dotfiles/.git" ]]; then
    echo "→ Cloning dotfiles to ~/Documents/GitHub/dotfiles..."
    REMOTE_URL="$(git -C "{{ .chezmoi.sourceDir }}" remote get-url origin 2>/dev/null || true)"
    if [[ -n "$REMOTE_URL" ]]; then
        git clone "$REMOTE_URL" "$HOME/Documents/GitHub/dotfiles"
        echo "✓ Dotfiles cloned to ~/Documents/GitHub/dotfiles"
    else
        echo "⚠️  Could not determine git remote; skipping dotfiles clone."
    fi
else
    echo "✓ ~/Documents/GitHub/dotfiles already exists"
fi
echo ""

echo "=========================================="
echo "  Bootstrap complete!"
echo "=========================================="
echo ""
echo "Next steps:"
echo "  • Restart your terminal to ensure all paths are set"
echo "  • Configure your apps (1Password, etc.)"
echo ""
echo "Chrome setup:"
echo "  • Open Chrome → Profile icon → Add → Sign in"
echo "  • Sign in with your Google accounts"
echo ""
echo "Wispr Flow is in the Brewfile (cask wispr-flow)."
echo "  • Grant Microphone and Accessibility in System Settings if prompted"
echo ""
{{ end -}}
