# mise is installed via Homebrew (/opt/homebrew/bin/mise)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Source machine-local secrets (not tracked by chezmoi or git)
if [ -f "$HOME/.secrets" ]; then
    source "$HOME/.secrets"
fi

# Enable persistent history
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS

# Configure the push directory stack (most people don't need this)
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT

setopt autocd

# Initialize completion
autoload -U compinit; compinit

alias rr='source ~/.zshrc'

# bat — cat replacement
alias cat='bat'

# eza aliases with your preferred defaults
alias ls='eza --icons --git'
alias ll='eza --icons --git --long --header --group'
alias la='eza --icons --git --long --header --group --all'
alias lt='eza --icons --git --tree --level=2'
#export EZA_COLORS="da=36:gm=33"
export EZA_ICONS_AUTO=1

# ripgrep — config file sets defaults, RIPGREP_CONFIG_PATH points to it
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"
alias grep='rg'
alias rgi='rg --ignore-case'
alias rgf='rg --files | rg'

# Helper: pretty disk free
alias freegb='df -k / | awk '\''NR==2 {printf "%.2f GB\n", $4*1024/1000000000}'\'''

# Set up fzf key bindings and fuzzy completion
source <(fzf --zsh)

# Set up zoxide to move between folders efficiently
eval "$(zoxide init zsh)"

# Set up the Starship prompt
eval "$(starship init zsh)"

export EDITOR="subl"
export VISUAL="$EDITOR"

# Docker Desktop CLI completions
fpath=($HOME/.docker/completions $fpath)
autoload -Uz compinit
compinit

# Ensure ~/.local/bin is on PATH
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# JDK 17 — Expo / Maestro / Android (Azul Zulu via Homebrew)
if /usr/libexec/java_home -v 17 &>/dev/null; then
  export JAVA_HOME="$(/usr/libexec/java_home -v 17)"
  export PATH="$JAVA_HOME/bin:$PATH"
fi

# Setup direnv
eval "$(direnv hook zsh)"

# Git helper methods
git-catchup() {
    git fetch origin staging:staging
    git rebase staging
}

git-catchup-push() {
    git fetch origin staging:staging
    git rebase staging
    git push --force-with-lease
}

alias gc='git-catchup'
alias gcp='git-catchup-push'
alias gss='git switch staging'
alias gsm='git switch main'
alias gp='git pull'
alias glola="git log --graph --pretty='%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset' --all"
alias gsb='git-squash-branch'

# granted.dev — assume must be sourced so env vars reach the parent shell
alias assume="source assume"

# 1Password CLI — sign in (session lasts 30 min of inactivity)
# Usage: opin           -> sign in to default account
#        opin ACCOUNT   -> sign in to a specific account
opin() {
  if [ -n "$1" ]; then
    eval "$(op signin --account "$1")"
  else
    eval "$(op signin)"
  fi
}

# ZSH plugins (must be sourced near the end)
[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && \
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# zsh-syntax-highlighting must be sourced last
[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && \
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
