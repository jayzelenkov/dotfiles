{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

echo "=========================================="
echo "  macOS Bootstrap (chezmoi run_once)"
echo "=========================================="
echo ""

# Authenticate once. Homebrew installs Zoom/AdGuard/Karabiner via
# `sudo installer` (and Things 3 via mas) from subprocesses with a different
# PPID and no TTY. macOS sudo defaults to timestamp_type=tty, which falls
# back to ppid when there is no terminal — so each pkg cask prompts again
# even after sudo -v. A temporary NOPASSWD drop-in covers those calls for
# this script only; it is deleted on exit.
echo "→ Requesting sudo access (you'll only be asked once)..."
sudo -v

SUDOERS_BOOTSTRAP=/etc/sudoers.d/chezmoi-bootstrap
cleanup_bootstrap() {
    sudo rm -f "$SUDOERS_BOOTSTRAP" 2>/dev/null || true
}
trap cleanup_bootstrap EXIT

{
    printf 'Defaults:%s timestamp_type=global\n' "$USER"
    printf 'Defaults:%s timestamp_timeout=120\n' "$USER"
    printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$USER"
} | sudo tee "$SUDOERS_BOOTSTRAP" > /dev/null
sudo chmod 440 "$SUDOERS_BOOTSTRAP"

if ! sudo -n true; then
    echo "⚠️  sudo is still prompting; pkg casks may ask for a password"
    sudo -v
fi
echo ""

# Xcode Command Line Tools
if xcode-select -p &>/dev/null; then
    echo "✓ Xcode Command Line Tools already installed"
else
    echo "→ Installing Xcode Command Line Tools..."
    xcode-select --install
    echo "  Waiting for Xcode CLI tools installation..."
    until xcode-select -p &>/dev/null; do
        sleep 5
    done
    echo "✓ Xcode Command Line Tools installed"
fi
echo ""

# Homebrew
if command -v brew &>/dev/null; then
    echo "✓ Homebrew already installed"
else
    echo "→ Installing Homebrew..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [[ -f "/opt/homebrew/bin/brew" ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
    echo "✓ Homebrew installed"
fi

echo "→ Updating Homebrew..."
brew update
echo "✓ Homebrew updated"
echo ""

# Install mas first so App Store entries work in brew bundle
if ! command -v mas &>/dev/null; then
    brew install mas
fi

# Add taps before bundle so formula names resolve correctly
brew tap updatest/tap https://github.com/updatest/tap.git 2>/dev/null || true

# Don't resume leftover partial downloads. Zoom/Linear CDNs return 403/404
# when Homebrew Range-requests past the real file size.
rm -f "${HOME}/Library/Caches/Homebrew/downloads/"*.incomplete 2>/dev/null || true

# Install all packages from Brewfile
echo "→ Installing packages from Brewfile..."
echo "  (This may take a while)"
echo ""
if brew bundle --file=/dev/stdin <<EOF
{{ include "Brewfile" }}
EOF
then
    echo ""
    echo "✓ All packages installed"
else
    echo ""
    echo "⚠️  Some packages failed to install. Run 'brew bundle --file=<Brewfile>' to retry."
fi

mkdir -p "$HOME/.local/bin"
ln -sfn "/Applications/Sublime Text.app/Contents/SharedSupport/bin/subl" "$HOME/.local/bin/subl"

{{ end -}}
